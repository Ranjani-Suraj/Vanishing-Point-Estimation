ninja_required_version = 1.3
cxx = c++
nvcc = /home/ranjanisuraj/miniconda3/envs/neurvps/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=DCN -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/ranjanisuraj/.local/lib/python3.10/site-packages/torch/include -isystem /home/ranjanisuraj/.local/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/ranjanisuraj/miniconda3/envs/neurvps/include -isystem /home/ranjanisuraj/miniconda3/envs/neurvps/include/python3.10 -fPIC -std=c++17 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=DCN -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/ranjanisuraj/.local/lib/python3.10/site-packages/torch/include -isystem /home/ranjanisuraj/.local/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/ranjanisuraj/miniconda3/envs/neurvps/include -isystem /home/ranjanisuraj/miniconda3/envs/neurvps/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options '-fPIC' -gencode=arch=compute_75,code=compute_75 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/ranjanisuraj/.local/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/home/ranjanisuraj/miniconda3/envs/neurvps/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build deform_conv_cuda.cuda.o: cuda_compile /home/ranjanisuraj/neurvps/neurvps/models/cpp/deform_conv_cuda.cu
build deform_conv.o: compile /home/ranjanisuraj/neurvps/neurvps/models/cpp/deform_conv.cpp





build DCN.so: link deform_conv_cuda.cuda.o deform_conv.o

default DCN.so
